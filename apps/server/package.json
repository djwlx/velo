{
  "name": "@velo/server",
  "version": "0.0.19",
  "files": [
    "dist",
    "src/migrations/steps",
    "drizzle",
    "drizzle.config.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--use-system-ca tsx watch src/bootstrap.ts",
    "build": "tsc",
    "start": "node dist/bootstrap.js",
    "migrate": "tsx src/bootstrap.ts --migrate-only",
    "lint": "oxlint",
    "check-types": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/structured-logger": "^1.0.0",
    "@velo/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "mime-types": "^3.0.2",
    "pino": "^10.4.0",
    "spark-md5": "^3.0.2",
    "tar": "^7.5.22",
    "undici": "^8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mime-types": "^3.0.1",
    "@types/spark-md5": "^3.0.5",
    "tsx": "^4.23.15"
  }
}
